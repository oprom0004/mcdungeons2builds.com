---
import type { GameBuild } from '../data/builds';

interface Props {
  build: GameBuild;
  compact?: boolean;
}

const { build, compact = false } = Astro.props;

const tierColors: Record<string, { badge: string; border: string }> = {
  'S+': { badge: 'bg-mc-sift/20 text-mc-sift border-mc-sift/40 shadow-glow-sift', border: 'border-mc-sift/50' },
  'S': { badge: 'bg-mc-gold/20 text-mc-gold border-mc-gold/40 shadow-glow-gold', border: 'border-mc-gold/40' },
  'A': { badge: 'bg-mc-soul/20 text-mc-soul border-mc-soul/40 shadow-glow-soul', border: 'border-mc-soul/30' },
};

const tierStyle = tierColors[build.tier] || tierColors['A'];
---

<article
  id={build.id}
  class={`relative rounded-2xl bg-mc-card/90 border ${tierStyle.border} p-6 sm:p-8 backdrop-blur-sm transition-all hover:border-mc-emerald/60 shadow-lg`}
>
  <!-- Card Header -->
  <div class="flex flex-wrap items-start justify-between gap-4 border-b border-mc-border/80 pb-5">
    <div class="space-y-1">
      <div class="flex items-center gap-2.5">
        <span class={`px-2.5 py-0.5 rounded-full text-xs font-mono font-black border ${tierStyle.badge}`}>
          TIER {build.tier}
        </span>
        <span class="px-2 py-0.5 rounded-md bg-mc-darkest/70 border border-mc-border text-mc-emerald text-xs font-mono font-medium">
          {build.playstyle}
        </span>
        <span class="text-xs font-mono text-mc-muted">
          {build.levelRequirement}
        </span>
      </div>
      <h3 class="text-2xl sm:text-3xl font-black text-white font-mono tracking-tight pt-1">
        {build.title}
      </h3>
      <p class="text-sm font-sans text-mc-muted">
        {build.subtitle}
      </p>
    </div>

    <!-- Rating Badge -->
    <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-mc-darkest border border-mc-border font-mono text-xs font-bold text-mc-gold">
      <span>★</span>
      <span class="text-white text-sm">{build.rating}</span>
      <span class="text-mc-muted text-[10px]">/ 10</span>
    </div>
  </div>

  <!-- Description & Core Loop -->
  <div class="py-5 space-y-3 text-sm font-sans text-slate-300 leading-relaxed">
    <p>{build.description}</p>
    <div class="p-3.5 rounded-xl bg-mc-darkest/80 border border-mc-border/80 text-xs font-mono text-slate-300">
      <span class="text-mc-emerald font-bold uppercase tracking-wider block mb-1">⚡ Core Combat Loop</span>
      {build.coreLoop}
    </div>
  </div>

  <!-- Loadout Matrix (Weapons & Armor) -->
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 py-4 border-t border-mc-border/60">
    
    <!-- Weapons Column -->
    <div class="space-y-4">
      <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-mc-gold flex items-center gap-1.5">
        <span>⚔️ Weapons &amp; Enchantments</span>
      </h4>

      <!-- Melee -->
      <div class="p-3.5 rounded-xl bg-mc-darkest/60 border border-mc-border">
        <div class="flex items-center justify-between text-xs font-mono mb-1.5">
          <span class="font-bold text-white flex items-center gap-1.5">
            <span class="text-mc-gold">🗡️</span> {build.weapons.melee.name}
          </span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-mc-gold/20 text-mc-gold border border-mc-gold/30">
            {build.weapons.melee.rarity}
          </span>
        </div>
        <p class="text-[11px] text-mc-muted mb-2 font-sans">{build.weapons.melee.role}</p>
        <div class="flex flex-wrap gap-1.5">
          {build.weapons.melee.enchantments.map((ench) => (
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-mc-border/50 text-slate-200 border border-mc-border">
              {ench}
            </span>
          ))}
        </div>
      </div>

      <!-- Ranged -->
      <div class="p-3.5 rounded-xl bg-mc-darkest/60 border border-mc-border">
        <div class="flex items-center justify-between text-xs font-mono mb-1.5">
          <span class="font-bold text-white flex items-center gap-1.5">
            <span class="text-mc-soul">🏹</span> {build.weapons.ranged.name}
          </span>
          <span class="text-[10px] px-1.5 py-0.5 rounded bg-mc-soul/20 text-mc-soul border border-mc-soul/30">
            {build.weapons.ranged.rarity}
          </span>
        </div>
        <p class="text-[11px] text-mc-muted mb-2 font-sans">{build.weapons.ranged.role}</p>
        <div class="flex flex-wrap gap-1.5">
          {build.weapons.ranged.enchantments.map((ench) => (
            <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-mc-border/50 text-slate-200 border border-mc-border">
              {ench}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- 4-Piece Armor Set Column -->
    <div class="space-y-4">
      <h4 class="font-mono text-xs font-bold uppercase tracking-wider text-mc-emerald flex items-center gap-1.5">
        <span>🛡️ 4-Piece Armor Synergy</span>
      </h4>

      <div class="grid grid-cols-2 gap-2 text-xs font-mono">
        <div class="p-2.5 rounded-lg bg-mc-darkest/60 border border-mc-border">
          <span class="text-[10px] text-mc-muted block uppercase">Helmet</span>
          <strong class="text-white text-[11px] truncate block">{build.armorSet.helmet.name}</strong>
          <span class="text-[10px] text-slate-400 block line-clamp-1">{build.armorSet.helmet.perk}</span>
        </div>
        <div class="p-2.5 rounded-lg bg-mc-darkest/60 border border-mc-border">
          <span class="text-[10px] text-mc-muted block uppercase">Chestplate</span>
          <strong class="text-white text-[11px] truncate block">{build.armorSet.chestplate.name}</strong>
          <span class="text-[10px] text-slate-400 block line-clamp-1">{build.armorSet.chestplate.perk}</span>
        </div>
        <div class="p-2.5 rounded-lg bg-mc-darkest/60 border border-mc-border">
          <span class="text-[10px] text-mc-muted block uppercase">Leggings</span>
          <strong class="text-white text-[11px] truncate block">{build.armorSet.leggings.name}</strong>
          <span class="text-[10px] text-slate-400 block line-clamp-1">{build.armorSet.leggings.perk}</span>
        </div>
        <div class="p-2.5 rounded-lg bg-mc-darkest/60 border border-mc-border">
          <span class="text-[10px] text-mc-muted block uppercase">Boots</span>
          <strong class="text-white text-[11px] truncate block">{build.armorSet.boots.name}</strong>
          <span class="text-[10px] text-slate-400 block line-clamp-1">{build.armorSet.boots.perk}</span>
        </div>
      </div>

      <!-- 4-Piece Set Bonus Banner -->
      <div class="p-2.5 rounded-lg bg-mc-emerald/10 border border-mc-emerald/30 text-xs font-mono text-mc-emerald">
        <strong class="uppercase text-[10px] tracking-wider block font-bold mb-0.5">✨ 4-Piece Set Bonus</strong>
        <p class="text-[11px] text-slate-200">{build.armorSet.setBonus}</p>
      </div>
    </div>
  </div>

  <!-- Talismans & Artifacts Bar -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-4 border-t border-mc-border/60">
    
    <!-- Talismans (New MCD2 Feature) -->
    <div class="space-y-2">
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-mc-sift flex items-center gap-1.5">
        <span>💎 Equipped Talismans (Passive)</span>
      </span>
      <div class="space-y-1.5 text-xs font-mono">
        {build.talismans.map((talisman) => (
          <div class="p-2 rounded-lg bg-mc-darkest/70 border border-mc-border flex items-start justify-between gap-2">
            <div>
              <span class="text-white font-bold text-[11px] block">{talisman.name}</span>
              <span class="text-[10px] text-mc-muted">{talisman.effect}</span>
            </div>
            <span class="text-[9px] px-1 py-0.5 rounded bg-mc-sift/20 text-mc-sift border border-mc-sift/30 whitespace-nowrap">
              {talisman.rarity}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Artifacts -->
    <div class="space-y-2">
      <span class="font-mono text-xs font-bold uppercase tracking-wider text-cyan-400 flex items-center gap-1.5">
        <span>🔮 Active Artifacts</span>
      </span>
      <div class="space-y-1.5 text-xs font-mono">
        {build.artifacts.map((artifact) => (
          <div class="p-2 rounded-lg bg-mc-darkest/70 border border-mc-border">
            <span class="text-white font-bold text-[11px] block">{artifact.name}</span>
            <span class="text-[10px] text-slate-400">{artifact.usage}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Stat Ratings & Pros/Cons -->
  <div class="pt-5 mt-5 border-t border-mc-border/60 grid grid-cols-1 sm:grid-cols-2 gap-4 text-xs font-mono">
    
    <!-- Stat Bars -->
    <div class="space-y-2">
      <span class="font-bold text-white uppercase text-[10px] tracking-wider block">Performance Ratings</span>
      
      {Object.entries(build.statRatings).map(([stat, rating]) => (
        <div class="flex items-center justify-between text-[11px]">
          <span class="capitalize text-slate-400">{stat.replace(/([A-Z])/g, ' $1')}</span>
          <div class="flex items-center gap-1">
            {Array.from({ length: 5 }).map((_, idx) => (
              <span
                class={`w-3 h-2 rounded-sm ${
                  idx < rating ? 'bg-mc-emerald' : 'bg-mc-darkest border border-mc-border'
                }`}
              />
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- Pros & Cons -->
    <div class="space-y-2">
      <div>
        <span class="text-mc-emerald font-bold text-[10px] uppercase block mb-1">Advantages</span>
        <ul class="space-y-0.5 text-[11px] text-slate-300 list-disc list-inside">
          {build.pros.map((pro) => (
            <li>{pro}</li>
          ))}
        </ul>
      </div>
      <div class="pt-2">
        <span class="text-mc-crimson font-bold text-[10px] uppercase block mb-1">Weaknesses</span>
        <ul class="space-y-0.5 text-[11px] text-slate-400 list-disc list-inside">
          {build.cons.map((con) => (
            <li>{con}</li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</article>
